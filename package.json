{
  "name": "weiqi-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "wasm:copy": "node scripts/copy-wasm.mjs",
    "predev": "npm run wasm:copy",
    "dev": "vite",
    "prebuild": "npm run wasm:copy",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:board": "npm run wasm:copy && tsc -p tsconfig.board-tests.json && playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "weiqi_board": "file:vendor/weiqi_board-0.1.0.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "1.90.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
