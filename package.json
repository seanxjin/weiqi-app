{
  "name": "weiqi-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "npm --prefix ../weiqi_board ci --ignore-scripts && npm run board:build",
    "board:build": "npm --prefix ../weiqi_board run build",
    "wasm:copy": "node scripts/copy-wasm.mjs",
    "predev": "npm run wasm:copy && npm run board:build",
    "dev": "vite",
    "prebuild": "npm run wasm:copy && npm run board:build",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "weiqi_board": "file:../weiqi_board",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
