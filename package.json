{
	"name": "weiqi-app",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"wasm:copy": "node scripts/copy-wasm.mjs",
		"predev": "npm run wasm:copy",
		"dev": "vite",
		"prebuild": "npm run wasm:copy",
		"build": "tsc -b && vite build",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"test:board": "npm run wasm:copy && tsc -p tsconfig.board-tests.json && playwright test",
		"preview": "vite preview"
	},
	"dependencies": {
		"i18next": "^27.2.9",
		"i18next-browser-languagedetector": "^8.3.1",
		"motion": "^14.6.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-i18next": "^18.0.3",
		"react-router": "^8.5.0",
		"weiqi-board": "1.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@playwright/test": "^1.64.1",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"typescript": "~6.0.3",
		"vite": "^8.3.4"
	}
}
